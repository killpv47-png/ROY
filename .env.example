# Copy to .env for local development. NEVER commit a real .env.
# In GitHub Actions, configure these as repository secrets instead.

# ---- Required ----
# Telegram bot token from @BotFather
BOT_TOKEN=
# PostgreSQL in production (postgres:// and postgresql:// are normalised to asyncpg).
# Local dev: sqlite+aiosqlite:///./data/dev.db
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# Generate with: python -m cr_analyst gen-key
APP_ENCRYPTION_KEY=

# ---- Owner / runner ----
# Numeric Telegram user id of the owner. If empty, the first /start becomes owner (atomic).
ADMIN_ID=
# Fine-grained PAT with "Actions: Read and write" on this repository only (used to chain runner workflows)
GH_PAT=

# ---- AI model (OpenAI-compatible) ----
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ---- Clash Royale ----
# Optional shared developer key from developer.clashroyale.com (bound to an allowed IP)
CLASH_API_TOKEN=
# Optional: refuse authenticated Clash API calls unless the egress IP equals this value
EXPECTED_EGRESS_IP=

# ---- Web research ----
# Tavily key (preferred provider). Without it the agent falls back to DuckDuckGo HTML search.
TAVILY_KEY=
TAVILY_SEARCH_DEPTH=basic
# auto | tavily | brave | duckduckgo
SEARCH_API_PROVIDER=auto
# Brave Search key (optional)
SEARCH_API_KEY=

# ---- Resilience ----
# Seconds to wait before continuing an interrupted task from the same step
RESUME_DELAY_SECONDS=10
MAX_RESUME_ATTEMPTS=5
MAX_RUNTIME_MINUTES=330
LEASE_TTL_SECONDS=120
CHECKPOINT_INTERVAL_SECONDS=300
MAX_AUTO_RESTARTS=120
AUTO_RESTART=true
TASK_WORKERS=3
LOG_LEVEL=INFO
