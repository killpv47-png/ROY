{"props": {"pageProps": {"publishDate": "2026-10-06T06:15:39.011Z", "title": "October Balance Changes", "bodyCollection": [{"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "heading-3", "data": {}, "content": [{"nodeType": "text", "value": "Balance Update \u2013 October 19th", "marks": [], "data": {}}]}, {"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "With the Clash Royale League World Finals coming early November, we are implementing the seasonal November balance changes earlier, in mid-October, to allow time for players to adapt before the biggest competition of the year!", "marks": [], "data": {}}]}, {"nodeType": "heading-2", "data": {}, "content": [{"nodeType": "text", "value": "NERFS \u2b07\ufe0f", "marks": [], "data": {}}]}, {"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Cannon Cart", "featureThumbnail": {"title": "cannoncart_balance.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/4cx7pOedzrfPgsSvwKbJAG/bc8e9da61dadd33a0fe20b490978fddb/cannoncart_balance.png", "width": 400, "height": 450}, "featureText": {"json": {"data": {}, "content": [{"data": {}, "content": [{"data": {}, "marks": [{"type": "bold"}], "value": "Damage: ", "nodeType": "text"}, {"data": {}, "marks": [], "value": "212 \u2192 202 (-5%)\n", "nodeType": "text"}, {"data": {}, "marks": [{"type": "bold"}], "value": "Mass:", "nodeType": "text"}, {"data": {}, "marks": [], "value": " 3 \u2192 6 (+100%)", "nodeType": "text"}], "nodeType": "paragraph"}], "nodeType": "document"}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Mortar decks are often impossible to break through, so we're targeting Cannon Cart to reduce the archetype's defensive potential.", "marks": [], "data": {}}]}, {"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Cannon Cart will also no longer be pushed around by Goblins!", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Dart Goblin", "featureThumbnail": {"title": "dartgoblin.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/6MZ8wPRbxwnDj1cmsg0dSr/8f3bcf3ed97822299ecf494a681d4ee6/dartgoblin.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Damage: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "151 \u2192 143 (-5%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Dart Goblin is the common denominator among the stronger spell bait decks, so we're reducing his damage output and reducing the amount of Double Trouble gum allowed on him!", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Minion Giant", "featureThumbnail": {"title": "miniongiant.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/3KLaXfRJt8xcCWUn0d3cvb/b19a443d8bf4af73b37b9dfa8047bbe0/miniongiant.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Damage: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "168 \u2192 153 (-9%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "For a Giant, this cave dweller applies too much quick pressure. We're making his bubbling burps slightly less wretched.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Rune Giant", "featureThumbnail": {"title": "runegiant.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/1Zs1h4OEXEe3sgfVXU4KGe/0119c15b705a0cfb465fb41e7a70ecb6/runegiant.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Enchantment Linger Duration: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "5s \u2192 0.5s (-90%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Rune Giant has forged her way into Ranked thanks to her synergy with Minion Giant and Little Prince, so her enchantments will no longer persist after she\u2019s been defeated.", "marks": [], "data": {}}]}, {"nodeType": "hr", "data": {}, "content": []}, {"nodeType": "heading-2", "data": {}, "content": [{"nodeType": "text", "value": "BUFFS \u2b06\ufe0f", "marks": [{"type": "bold"}], "data": {}}]}, {"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Hero Electro Wizard", "featureThumbnail": {"title": "heroelectrowizard.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/4qt58zzanwQR3PrkdL8Ujj/8777c0134cd52c82bb0aeaaf8e6e6221/heroelectrowizard.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Removed Attack Delay after Ability", "marks": [{"type": "bold"}], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Hero Electro Wizard's ability often fails due to his attack delay, so we're removing the delay entirely.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Electro Dragon", "featureThumbnail": {"title": "electrodragon.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/3hR3DHtQDfc7FSxOEy70vY/33c7136ddd96cdfc1c6110a348f6b9e9/electrodragon.png", "width": 400, "height": 450}, "featureText": {"json": {"data": {}, "content": [{"data": {}, "content": [{"data": {}, "marks": [{"type": "bold"}], "value": "First Hit Time: ", "nodeType": "text"}, {"data": {}, "marks": [], "value": "0.7s \u2192 0.5s (-29%)", "nodeType": "text"}], "nodeType": "paragraph"}], "nodeType": "document"}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Due to its slow first hit time, Electro Dragon feels unreactive on defense. This buff will also make it harder to distract him on defense.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Flying Machine", "featureThumbnail": {"title": "flyingmachine.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/6qiDOPiY0ab5VuFMXZY9LW/c58fb4c8036cb3f1dc5c25c339121fdf/flyingmachine.png", "width": 400, "height": 450}, "featureText": {"json": {"data": {}, "content": [{"data": {}, "content": [{"data": {}, "marks": [{"type": "bold"}], "value": "Damage: ", "nodeType": "text"}, {"data": {}, "marks": [], "value": "171 \u2192 179 (+4%)", "nodeType": "text"}], "nodeType": "paragraph"}], "nodeType": "document"}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Flying Machine struggles to compete with other ranged and flying cards, so Builder\u2019s giving this contraption a slight damage boost.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Void", "featureThumbnail": {"title": "void.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/2Wo5pq3oIOv9bt63Oq8FGf/fb30200e274eb3d28053908b87fbb4c8/void.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "2\u20134 Target Damage: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "296 \u2192 307 (+3%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Archers and Firecracker will now be taken out by a single 2-4 Target Void hit.", "marks": [], "data": {}}]}, {"nodeType": "hr", "data": {}, "content": []}, {"nodeType": "heading-2", "data": {}, "content": [{"nodeType": "text", "value": "REWORKS \ud83d\udd04", "marks": [{"type": "bold"}], "data": {}}]}, {"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Skeleton Barrel Evolution", "featureThumbnail": {"title": "skeletonbarrelevolution.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/5IG9na6EqujhjCCfQTu4cQ/11c27aba55e05a6f80077522dce39398/skeletonbarrelevolution.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Death Damage: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "192 \u2192 163 (-15%)", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Skeleton Barrel", "featureThumbnail": {"title": "skeletonbarrel.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/3As2BATLY0xnB54BJNBi9I/ea269df0dcdc2b52e21e37dc7d98260e/skeletonbarrel.png", "width": 400, "height": 450}, "featureText": {"json": {"data": {}, "content": [{"data": {}, "content": [{"data": {}, "marks": [{"type": "bold"}], "value": "Death Damage: ", "nodeType": "text"}, {"data": {}, "marks": [], "value": "145 \u2192 163 (+12%)", "nodeType": "text"}], "nodeType": "paragraph"}], "nodeType": "document"}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Skeleton Barrel is a relatively weak card without its Evolution, so we're bringing their power closer together by standardizing their death damage.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Skeletons", "featureThumbnail": {"title": "skeletons.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/5CUsCSrEskhjMLGLpY156e/4901dc24f200c3917ada2e93ef489174/skeletons.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Spawn Spread: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "0.4 \u2192 0.5 tiles (+25%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Skeletons will now always split when placed on middle tiles.", "marks": [], "data": {}}]}, {"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "While we won't be introducing balance changes at the start of the November season, we'll continue monitoring the meta and may make further adjustments after the Clash Royale League World Finals.", "marks": [], "data": {}}]}, {"nodeType": "hr", "data": {}, "content": []}, {"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "heading-3", "data": {}, "content": [{"nodeType": "text", "value": "Balance Update \u2013 October 6th", "marks": [], "data": {}}]}, {"nodeType": "heading-2", "data": {}, "content": [{"nodeType": "text", "value": "NERFS \u2b07\ufe0f", "marks": [], "data": {}}]}, {"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Hero Ice Wizard", "featureThumbnail": {"title": "heroicewizard.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/3a0xrGNjZps7KUkb7CbNms/bf681352357537463b018d8f87da3285/heroicewizard.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Freeze Damage: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "89 \u2192 46 (-49%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Hero Ice Wizard claims his icy little buddy is all frost and no bite, but we're not buying it. Frosty Fella will no longer take out Skeletons and Bats with his freeze effect.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Cannon Evolution", "featureThumbnail": {"title": "cannonevolution.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/6lAyu6et4P9dfzn4HGnbcj/a759ce4bdc2084b21472e51aa2930876/cannonevolution.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Barrage Damage: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "281 \u2192 261 (-7%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "It's Minion Giant's world now and Evolved Cannon is just liv-... still the best building in the meta? Its barrage will still take out Dart Goblin, but be slightly less effective against big pushes.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Barbarian Barrel", "featureThumbnail": {"title": "barbarianbarrel.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/17p4WYgrqE3vJKsBRBNlAf/50c487099e4739997de7f402cdeda3a4/barbarianbarrel.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Damage: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "232 \u2192 215 (-8%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "After the buffs to Barbarians, their rock \u2018n roll cousin quickly became the go-to small spell for both cycle and control decks. It will no longer fully counter Wall Breakers.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Elixir Collector", "featureThumbnail": {"title": "elixircollector.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/zGtpJ9UNechV0swppFOY1/cd6b16b7ea7838f35221f150158f3037/elixircollector.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Lifetime: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "1m 33s \u2192 1m 50s (+18%)\n", "marks": [], "data": {}}, {"nodeType": "text", "value": "Production Speed: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "13s \u2192 15s (+15%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Considering the buff to Three Musketeers, we wanted them to be viable without depending on Elixir Collector. Its RoE (Return on Elixir, yes we made that up) will now take longer to pay off.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Minion Giant", "featureThumbnail": {"title": "miniongiant.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/3KLaXfRJt8xcCWUn0d3cvb/b19a443d8bf4af73b37b9dfa8047bbe0/miniongiant.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Hit Speed: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "1.5s \u2192 1.7s (+13%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Minion Giant was too punishing for a flying win condition. We're slowing down his hit speed to retain his 'Giant' feel while cutting down on his damage output.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Royal Ghost", "featureThumbnail": {"title": "royalghost.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/6epdsLZdPyR3GO8ilrnURr/68896c7f06ac08026307bb67a21f10bb/royalghost.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Hitpoints: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "1210 \u2192 1152 (-5%)", "marks": [], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Royal Ghost had floated beyond his usual control and bridge spam homes and into bait and cycle decks. A hitpoint nerf should make him easier to exorcise.", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Skeletons", "featureThumbnail": {"title": "skeletons.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/5CUsCSrEskhjMLGLpY156e/4901dc24f200c3917ada2e93ef489174/skeletons.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Tighter Spawn Spread", "marks": [{"type": "bold"}], "data": {}}]}]}}}, {"__typename": "TextBlock", "title": "", "text": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "As well as providing some of the best cycling utility in the game, Skeletons offer high damage and strong distraction value. A tighter spawn spread will make them more vulnerable to splash damage.", "marks": [], "data": {}}]}, {"nodeType": "hr", "data": {}, "content": []}, {"nodeType": "heading-2", "data": {}, "content": [{"nodeType": "text", "value": "BUFFS \u2b06\ufe0f", "marks": [{"type": "bold"}], "data": {}}]}, {"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Goblin Barrel", "featureThumbnail": {"title": "goblinbarrel.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/3IbDPFEuCesVbh6nQlIUjV/5aee1dfa0b1f2a2feeb4c0230312e64c/goblinbarrel.png", "width": 400, "height": 450}, "featureText": {"json": {"data": {}, "content": [{"data": {}, "content": [{"data": {}, "marks": [{"type": "bold"}], "value": "First Hit Speed: ", "nodeType": "text"}, {"data": {}, "marks": [], "value": "0.4s \u2192 0.3s (-25%)", "nodeType": "text"}], "nodeType": "paragraph"}], "nodeType": "document"}}}, {"__typename": "FeatureBlock", "title": "Goblin Drill", "featureThumbnail": {"title": "goblindrill.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/1SasChghB3GEWD581b1hiv/20f9b45fba067dbc4892d208c7bb2c2f/goblindrill.png", "width": 400, "height": 450}, "featureText": {"json": {"data": {}, "content": [{"data": {}, "content": [{"data": {}, "marks": [{"type": "bold"}], "value": "Crown Tower Spawn Damage: ", "nodeType": "text"}, {"data": {}, "marks": [], "value": "0 \u2192 20", "nodeType": "text"}], "nodeType": "paragraph"}], "nodeType": "document"}}}, {"__typename": "FeatureBlock", "title": "Lava Hound", "featureThumbnail": {"title": "lavahound.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/5sA3PRu3OJCYADdT4H3Ahu/b1e0baed8068d5fa51d84caccf3cb995/lavahound.png", "width": 400, "height": 450}, "featureText": {"json": {"nodeType": "document", "data": {}, "content": [{"nodeType": "paragraph", "data": {}, "content": [{"nodeType": "text", "value": "Damage ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "53 \u2192 71 (+33%)\n", "marks": [], "data": {}}, {"nodeType": "text", "value": "Hit Speed: ", "marks": [{"type": "bold"}], "data": {}}, {"nodeType": "text", "value": "1.3s \u2192 1.5s (+15%)", "marks": [], "data": {}}]}]}}}, {"__typename": "FeatureBlock", "title": "Ram Rider", "featureThumbnail": {"title": "ramrider.png", "url": "https://clashroyale.inbox.supercell.com/9jtsgmsiuthj/1HOnYoZRRyRrhH7BQ4ecrx/2127d9bad5db865862b4cefb612406c9/ramrider.png", "width": 400, "height": 450}, "featureT